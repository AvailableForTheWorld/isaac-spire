{
  "name": "isaac-spire",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x",
    "pnpm": "11.x"
  },
  "scripts": {
    "dev": "pnpm --filter @isaac-spire/game build && pnpm --parallel --filter @isaac-spire/api --filter @isaac-spire/web dev",
    "dev:web": "pnpm --filter @isaac-spire/web dev",
    "dev:api": "pnpm --filter @isaac-spire/game build && pnpm --filter @isaac-spire/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
